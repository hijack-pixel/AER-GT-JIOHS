__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# Private data and derived artifacts are intentionally excluded.
data/private/
data/**/*.mat
outputs/*
!outputs/.gitkeep
checkpoints/
scalers/
*.pth
*.pt
*.pkl

# Paper-trained model artifacts are intentionally versioned.
!model_artifacts/
!model_artifacts/**/
!model_artifacts/paper_trained/checkpoints/*.pth
!model_artifacts/paper_trained/scalers/*.pkl
!model_artifacts/paper_trained/*.json
!model_artifacts/paper_trained/README.md

# Raw and intermediate data files are never versioned outside outputs/.
*.tif
*.tiff
*.npy
*.npz
*.h5
*.hdf5

# Credentials are never versioned.
.env
*.pem
*.key

# Local/editor files.
.idea/
.vscode/
.DS_Store
Thumbs.db
